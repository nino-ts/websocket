{
    "author": "Ninots Framework",
    "description": "Bun-native WebSocket server with rooms, pub/sub, and handlers for Ninots Framework",
    "devDependencies": {
        "@types/bun": "^1.3.13",
        "typescript": "^6.0.3"
    },
    "engines": {
        "bun": ">=1.0.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
